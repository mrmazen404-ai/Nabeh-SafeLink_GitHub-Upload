# ============================================================
# Nabeh SafeLink - Environment Configuration
# ============================================================

# ===== App =====
APP_NAME=Nabeh SafeLink
APP_VERSION=1.0.0

# ===== Supabase (مشروع واحد فقط) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key
SUPABASE_SECRET_KEY=replace_with_your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co
# ===== Auth (User) =====
AUTH_JWT_SECRET=replace_with_your_auth_jwt_secret
AUTH_OTP_PEPPER=replace_with_your_auth_otp_pepper
AUTH_ACCESS_TOKEN_MINUTES=replace_with_your_auth_access_token_minutes
AUTH_OTP_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5

# ===== Auth (Admin) =====
ADMIN_JWT_SECRET=replace_with_your_admin_jwt_secret
ADMIN_JWT_ISSUER=nabeh-admin
ADMIN_JWT_AUDIENCE=nabeh-admin-api
ADMIN_ACCESS_TOKEN_MINUTES=replace_with_your_admin_access_token_minutes
ADMIN_REFRESH_TOKEN_DAYS=replace_with_your_admin_refresh_token_days
ADMIN_LOGIN_RATE_LIMIT=5

# ===== Admin Bootstrap =====
ADMIN_BOOTSTRAP_TOKEN=replace_with_your_admin_bootstrap_token
ADMIN_IP_SALT=replace_with_your_admin_ip_salt
ADMIN_TOTP_ENCRYPTION_KEY=replace_with_your_admin_totp_encryption_key
ADMIN_TOTP_ISSUER=Nabeh Admin

# ===== Rate Limiting =====
NABEH_RATE_LIMIT_SALT=replace_with_your_nabeh_rate_limit_salt
VISITOR_HASH_SALT=replace_with_your_visitor_hash_salt

# ===== CORS =====
NABEH_CORS_ALLOWED_ORIGINS=https://intellidefenda.com,https://www.intellidefenda.com,http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173
NABEH_TRUST_PROXY_HEADERS=true

# ===== Threat Intelligence =====
NABEH_TRUST_MODEL_ARTIFACT=1
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=replace_with_a_model_available_in_your_google_project
GEMINI_RATE_LIMIT_RETRIES=1
GEMINI_RATE_LIMIT_BACKOFF_SECONDS=1
GEMINI_RATE_LIMIT_MAX_WAIT_SECONDS=4
GEMINI_MAX_CONCURRENCY=2
VIRUSTOTAL_API_KEY=replace_with_your_virustotal_api_key

# ===== EmailJS =====
EMAILJS_SERVICE_ID=replace_with_your_emailjs_service_id
EMAILJS_TEMPLATE_ID=replace_with_your_emailjs_template_id
EMAILJS_PUBLIC_KEY=replace_with_your_emailjs_public_key
EMAILJS_PRIVATE_KEY=replace_with_your_emailjs_private_key





UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_redis_rest_token
UPSTASH_REDIS_REST_URL=https://capable-moray-224543.upstash.io
